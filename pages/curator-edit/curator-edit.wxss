.curator-page { width: 100%; height: 100vh; overflow: hidden; background: #F2EFE8; display: flex; flex-direction: column; }

/* 导航栏 */
.curator-navbar { display: flex; align-items: center; justify-content: space-between; padding-right: 34rpx; padding-left: 34rpx; padding-bottom: 20rpx; background: #F2EFE8; position: sticky; top: 0; z-index: 10; }
.nav-back { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; }
.nav-arrow { font-size: 36rpx; color: #1D201D; }
.nav-title { font-family: "Songti SC", serif; font-size: 36rpx; color: #1D201D; font-weight: 600; }
.nav-step { color: #9A978F; font-size: 22rpx; letter-spacing: 2rpx; }

/* 步骤区 */
.step-scroll { width: 100%; min-height: 0; flex: 1; }
.step-header { padding: 40rpx 36rpx 20rpx; }
.step-eyebrow { display: block; color: #9A3D2F; font-size: 18rpx; letter-spacing: 3rpx; }
.step-title { display: block; margin-top: 10rpx; font-family: "Songti SC", serif; font-size: 42rpx; color: #1D201D; }
.step-desc { display: block; margin-top: 12rpx; color: #85827A; font-size: 22rpx; line-height: 1.6; }

/* 步骤1: 选择作品 */
.selected-bar { display: flex; align-items: center; min-height: 90rpx; box-sizing: border-box; margin: 0 36rpx 20rpx; padding: 16rpx 20rpx; background: rgba(29,32,29,.035); border: 1rpx solid rgba(29,32,29,.1); border-radius: 8rpx; }
.selected-bar.has-selection { background: rgba(154,61,47,.06); border-color: rgba(154,61,47,.15); }
.selected-label { font-size: 20rpx; color: #9A3D2F; margin-right: 16rpx; white-space: nowrap; }
.selected-thumbs { display: flex; gap: 8rpx; overflow: hidden; flex: 1; }
.selected-thumb { width: 56rpx; height: 56rpx; border-radius: 4rpx; flex-shrink: 0; }

.pick-grid { display: flex; flex-wrap: wrap; padding: 0 28rpx; gap: 12rpx; }
.pick-card { position: relative; width: calc(33.33% - 8rpx); box-sizing: border-box; border-radius: 6rpx; overflow: hidden; background: #E7E1D6; }
.pick-img { width: 100%; height: 280rpx; display: block; }
.pick-overlay { position: absolute; inset: 0; background: rgba(154,61,47,.35); display: flex; align-items: center; justify-content: center; }
.pick-check { font-size: 48rpx; color: #F8F3E9; }
.pick-info { padding: 10rpx 12rpx 14rpx; }
.pick-title { display: block; font-family: "Songti SC", serif; font-size: 20rpx; color: #1D201D; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pick-artist { display: block; font-size: 16rpx; color: #9A978F; margin-top: 4rpx; }
.pick-card.picked { box-shadow: inset 0 0 0 3rpx #9A3D2F; }

/* 表单 */
.form-group { padding: 24rpx 36rpx; }
.form-label { display: block; font-size: 22rpx; color: #6C6B64; margin-bottom: 12rpx; }
.form-sublabel { display: block; font-size: 18rpx; color: #A09D95; margin-bottom: 12rpx; }
.form-input { width: 100%; height: 80rpx; padding: 0 24rpx; border: 1rpx solid rgba(29,32,29,.16); border-radius: 8rpx; background: #FFFDF8; font-size: 28rpx; color: #1D201D; box-sizing: border-box; }
.form-textarea { width: 100%; padding: 20rpx 24rpx; border: 1rpx solid rgba(29,32,29,.16); border-radius: 8rpx; background: #FFFDF8; font-size: 26rpx; color: #1D201D; min-height: 160rpx; box-sizing: border-box; line-height: 1.6; }
.form-hint { display: block; text-align: right; font-size: 18rpx; color: #B5B1A8; margin-top: 8rpx; }

/* 已选预览 */
.selected-preview { padding: 0 36rpx 20rpx; }
.preview-label { display: block; font-size: 20rpx; color: #9A978F; margin-bottom: 12rpx; }
.preview-thumbs { display: flex; gap: 10rpx; flex-wrap: wrap; }
.preview-thumb { width: 80rpx; height: 80rpx; border-radius: 6rpx; }

/* 字体选项 */
.font-options { display: flex; flex-wrap: wrap; gap: 12rpx; }
.font-opt { padding: 16rpx 28rpx; border: 1rpx solid rgba(29,32,29,.16); border-radius: 8rpx; background: #FFFDF8; }
.font-opt.active { border-color: #9A3D2F; background: rgba(154,61,47,.06); }
.font-opt-name { font-size: 26rpx; color: #1D201D; }

/* 贴纸选项 */
.sticker-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.sticker-opt { display: flex; flex-direction: column; align-items: center; width: calc(25% - 9rpx); padding: 20rpx 0; border: 1rpx solid rgba(29,32,29,.12); border-radius: 8rpx; background: #FFFDF8; }
.sticker-opt.active { border-color: #9A3D2F; background: rgba(154,61,47,.06); }
.sticker-icon { font-size: 40rpx; line-height: 1; }
.sticker-name { font-size: 16rpx; color: #85827A; margin-top: 8rpx; }

/* 背景色选项 */
.color-options { display: flex; gap: 16rpx; }
.color-opt { width: 64rpx; height: 64rpx; border-radius: 50%; border: 2rpx solid rgba(29,32,29,.1); display: flex; align-items: center; justify-content: center; }
.color-opt.active { border-color: #9A3D2F; border-width: 3rpx; }
.color-check { font-size: 24rpx; color: #9A3D2F; }

/* 署名选项 */
.sign-options { display: flex; gap: 12rpx; }
.sign-opt { flex: 1; padding: 20rpx; border: 1rpx solid rgba(29,32,29,.12); border-radius: 8rpx; background: #FFFDF8; text-align: center; }
.sign-opt.active { border-color: #9A3D2F; background: rgba(154,61,47,.06); }
.sign-opt-label { display: block; font-family: "Songti SC", serif; font-size: 24rpx; color: #1D201D; }
.sign-opt-desc { display: block; font-size: 16rpx; color: #9A978F; margin-top: 6rpx; }

/* 小预览 */
.mini-preview { padding: 36rpx; }
.mini-poster { position: relative; padding: 48rpx 36rpx; border-radius: 8rpx; border: 1rpx solid rgba(29,32,29,.08); min-height: 400rpx; overflow: hidden; }
.mini-sticker-corner { position: absolute; top: 24rpx; right: 24rpx; font-size: 36rpx; opacity: .6; }
.mini-theme { display: block; font-family: "Songti SC", serif; font-size: 36rpx; color: #1D201D; margin-top: 40rpx; }
.mini-prologue { display: block; margin-top: 16rpx; font-size: 18rpx; color: #6C6B64; line-height: 1.6; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
.mini-artworks { display: flex; gap: 8rpx; margin-top: 28rpx; }
.mini-art-img { width: 120rpx; height: 120rpx; border-radius: 4rpx; flex-shrink: 0; }
.mini-art-more { width: 120rpx; height: 120rpx; border-radius: 4rpx; background: rgba(29,32,29,.06); display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: #9A978F; flex-shrink: 0; }
.mini-sign { margin-top: 28rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(29,32,29,.1); font-size: 18rpx; color: #85827A; letter-spacing: 1rpx; }

/* 底部操作栏 */
.bottom-bar { display: flex; gap: 16rpx; padding: 16rpx 36rpx; background: #F2EFE8; border-top: 1rpx solid rgba(29,32,29,.08); }
.bar-btn { flex: 1; height: 84rpx; display: flex; align-items: center; justify-content: center; border-radius: 40rpx; font-size: 26rpx; letter-spacing: 1rpx; margin: 0; padding: 0; }
.bar-btn-prev { background: transparent; border: 1rpx solid rgba(29,32,29,.2); color: #1D201D; }
.bar-btn-next { background: #1D201D; color: #F8F3E9; border: none; }
.bar-btn-finish { background: #9A3D2F; color: #F8F3E9; border: none; }
.bar-btn[disabled] { opacity: .4; }
