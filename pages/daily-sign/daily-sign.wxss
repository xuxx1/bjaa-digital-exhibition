.daily-sign-page { min-height: 100vh; background: #F2EFE8; padding-bottom: env(safe-area-inset-bottom); }

.ds-header { display: flex; align-items: center; justify-content: space-between; padding: calc(env(safe-area-inset-top) + 18rpx) 30rpx 18rpx; }
.ds-back { color: #9A3D2F; font-size: 26rpx; letter-spacing: 1rpx; min-width: 100rpx; }
.ds-header-title { font-family: "Songti SC", serif; font-size: 32rpx; color: #1D201D; }
.ds-header-right { min-width: 100rpx; }

.ds-preview-wrap { padding: 40rpx 48rpx; }
.ds-preview-card { overflow: hidden; padding: 48rpx; border-radius: 12rpx; background: #F8F4EB; box-shadow: 0 16rpx 48rpx rgba(43,42,37,.12); }
.ds-date-block { display: flex; align-items: flex-end; }
.ds-date-day { color: #9A3D2F; font-family: Georgia, serif; font-size: 96rpx; font-weight: 700; line-height: .85; }
.ds-date-copy { display: flex; flex-direction: column; margin-left: 20rpx; color: #1D201D; font-size: 23rpx; line-height: 1.6; }
.ds-date-copy text:last-child { color: #8A877F; font-size: 20rpx; }
.ds-rule { height: 2rpx; margin: 34rpx 0 38rpx; background: #9A3D2F; }
.ds-work-image { display: block; width: 100%; border-radius: 3rpx; background: #E7E1D6; }
.ds-image-error { display: flex; align-items: center; justify-content: center; height: 520rpx; background: #E7E1D6; color: #99958D; font-size: 21rpx; }
.ds-card-title { display: block; margin-top: 42rpx; color: #1D201D; font-family: "Songti SC", serif; font-size: 40rpx; font-weight: 700; line-height: 1.4; }
.ds-card-artist { display: block; margin-top: 17rpx; color: #9A3D2F; font-size: 23rpx; }
.ds-card-category { display: block; margin-top: 13rpx; color: #8A877F; font-size: 20rpx; }
.ds-card-intro { display: -webkit-box; overflow: hidden; margin-top: 25rpx; color: #6C6B64; font-family: "Songti SC", serif; font-size: 22rpx; line-height: 1.8; text-align: justify; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
.ds-card-footer { display: flex; justify-content: space-between; margin-top: 34rpx; padding-top: 25rpx; border-top: 1rpx solid rgba(29,32,29,.12); color: #9A3D2F; font-size: 18rpx; }
.ds-card-footer text:last-child { color: #B5B2AA; }
.ds-export-canvas { position: fixed; top: 0; left: -2000px; pointer-events: none; opacity: 0; }

.ds-actions { display: flex; gap: 18rpx; padding: 0 48rpx; }
.ds-btn { flex: 1; display: flex; align-items: center; justify-content: center; height: 80rpx; margin: 0; padding: 0; border-radius: 6rpx; font-size: 24rpx; line-height: 1; letter-spacing: 2rpx; text-align: center; }
.ds-btn-save { border: 1rpx solid rgba(29,32,29,.18); background: #1D201D; color: #F8F3E9; }
.ds-btn-share { border: 1rpx solid rgba(29,32,29,.18); background: transparent; color: #1D201D; }
