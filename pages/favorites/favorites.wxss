.favorites-scroll { height: 100vh; background: #F2EFE8; }
.favorites-page { min-height: 100vh; box-sizing: border-box; padding-bottom: 80rpx; }
.favorites-head { padding: 62rpx 36rpx 38rpx; }
.favorites-title { display: block; margin-top: 14rpx; font-family: "Songti SC", serif; font-size: 56rpx; }
.favorites-summary { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 35rpx; padding: 25rpx 0; border-top: 1rpx solid rgba(29,32,29,.14); border-bottom: 1rpx solid rgba(29,32,29,.14); color: #85827A; font-family: "Songti SC", serif; font-size: 20rpx; }
.favorite-count { color: #272A26; font-family: Georgia, serif; font-size: 48rpx; line-height: 1; }
.favorite-tabs { display: flex; margin-top: 30rpx; border-bottom: 1rpx solid rgba(29,32,29,.14); }
.favorite-tab { position: relative; display: flex; align-items: center; margin-right: 48rpx; padding: 15rpx 0 19rpx; color: #8C8981; font-family: "Songti SC", serif; font-size: 27rpx; }
.favorite-tab text:last-child { margin-left: 9rpx; color: #A09D95; font-family: Georgia, serif; font-size: 17rpx; }
.favorite-tab.active { color: #252824; }
.favorite-tab.active::after { content: ''; position: absolute; right: 0; bottom: -1rpx; left: 0; height: 4rpx; background: #A64234; }
.favorite-list { padding: 0 36rpx; }
.favorite-card { display: flex; margin-bottom: 25rpx; overflow: hidden; border-radius: 7rpx; background: #E8E3D9; }
.favorite-image { flex: none; width: 255rpx; min-height: 300rpx; background: #D7D2C8; }
.favorite-content { display: flex; min-width: 0; flex: 1; box-sizing: border-box; flex-direction: column; padding: 24rpx 23rpx 22rpx; }
.favorite-topline { display: flex; align-items: center; justify-content: space-between; color: #A34436; font-size: 16rpx; letter-spacing: 2rpx; }
.remove { padding: 0 0 12rpx 18rpx; color: #A34436; font-size: 31rpx; letter-spacing: 0; }
.favorite-name { display: block; margin-top: 18rpx; overflow: hidden; font-family: "Songti SC", serif; font-size: 30rpx; text-overflow: ellipsis; white-space: nowrap; }
.favorite-artist { display: block; margin-top: 9rpx; color: #817F78; font-size: 17rpx; }
.favorite-meta { display: flex; justify-content: space-between; margin-top: auto; padding-top: 18rpx; border-top: 1rpx solid rgba(29,32,29,.11); color: #939087; font-size: 16rpx; }
.favorite-meta text:last-child { color: #373934; }
.exhibition-favorite-list { padding: 0 36rpx; }
.exhibition-favorite-card { margin-bottom: 35rpx; overflow: hidden; border-radius: 7rpx; background: #E8E3D9; }
.exhibition-favorite-image-wrap { position: relative; height: 330rpx; }
.exhibition-favorite-image { width: 100%; height: 100%; }
.exhibition-favorite-remove { position: absolute; top: 19rpx; right: 19rpx; display: flex; align-items: center; justify-content: center; width: 57rpx; height: 57rpx; border-radius: 50%; background: #A64234; color: white; font-size: 29rpx; }
.exhibition-favorite-tag { position: absolute; bottom: 18rpx; left: 19rpx; padding: 9rpx 15rpx; border-radius: 30rpx; background: rgba(246,241,231,.9); color: #9D4134; font-size: 16rpx; letter-spacing: 2rpx; }
.exhibition-favorite-body { padding: 25rpx 25rpx 23rpx; }
.exhibition-favorite-title { display: block; font-family: "Songti SC", serif; font-size: 32rpx; line-height: 1.45; }
.exhibition-favorite-intro { display: -webkit-box; overflow: hidden; margin-top: 13rpx; color: #79776F; font-family: "Songti SC", serif; font-size: 20rpx; line-height: 1.75; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.exhibition-favorite-meta { display: flex; justify-content: space-between; margin-top: 19rpx; padding-top: 17rpx; border-top: 1rpx solid rgba(29,32,29,.11); color: #929087; font-size: 16rpx; }
.exhibition-favorite-meta text:last-child { color: #373934; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 70rpx 70rpx 30rpx; text-align: center; }
.empty-art { position: relative; width: 270rpx; height: 230rpx; margin-bottom: 37rpx; }
.empty-frame { position: absolute; inset: 12rpx 25rpx 0; border: 2rpx solid #6F716A; transform: rotate(-4deg); }
.empty-frame::after { content: ''; position: absolute; right: 25rpx; bottom: 30rpx; left: 25rpx; height: 2rpx; background: #A64133; transform: rotate(-16deg); }
.empty-sun { position: absolute; top: 60rpx; left: 92rpx; width: 70rpx; height: 70rpx; border-radius: 50%; background: #C99366; }
.empty-title { font-family: "Songti SC", serif; font-size: 35rpx; }
.empty-copy { margin-top: 17rpx; color: #85827A; font-size: 20rpx; line-height: 1.8; }
.discover-button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 340rpx; height: 86rpx; margin-top: 35rpx; padding: 0; border-radius: 5rpx; background: #222420; color: white; font-size: 22rpx; line-height: 1; letter-spacing: 3rpx; text-align: center; }

/* 讲座/活动收藏卡片 */
.program-favorite-list { padding: 0 36rpx; }
.program-favorite-card { margin-bottom: 35rpx; overflow: hidden; border-radius: 7rpx; background: #E8E3D9; }
.program-favorite-image-wrap { position: relative; height: 330rpx; }
.program-favorite-image { width: 100%; height: 100%; }
.program-favorite-remove { position: absolute; top: 19rpx; right: 19rpx; display: flex; align-items: center; justify-content: center; width: 57rpx; height: 57rpx; border-radius: 50%; background: #A64234; color: white; font-size: 29rpx; }
.program-favorite-tag { position: absolute; bottom: 18rpx; left: 19rpx; padding: 9rpx 15rpx; border-radius: 30rpx; background: rgba(246,241,231,.9); color: #9D4134; font-size: 16rpx; letter-spacing: 2rpx; }
.program-favorite-body { padding: 25rpx 25rpx 23rpx; }
.program-favorite-title { display: block; font-family: "Songti SC", serif; font-size: 32rpx; line-height: 1.45; }
.program-favorite-meta { display: block; margin-top: 10rpx; color: #85827A; font-size: 17rpx; line-height: 1.55; }
.program-favorite-summary { display: -webkit-box; overflow: hidden; margin-top: 13rpx; color: #79776F; font-family: "Songti SC", serif; font-size: 20rpx; line-height: 1.75; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.program-favorite-footer { display: flex; justify-content: space-between; margin-top: 19rpx; padding-top: 17rpx; border-top: 1rpx solid rgba(29,32,29,.11); color: #929087; font-size: 16rpx; }
.program-favorite-footer text:last-child { color: #373934; }
.favorites-footer { display: flex; flex-direction: column; margin: 70rpx 36rpx 0; padding: 25rpx 0; border-top: 1rpx solid rgba(29,32,29,.13); color: #99968E; font-size: 15rpx; line-height: 1.9; letter-spacing: 1rpx; }
