.lecture-review-grid { display: flex; justify-content: space-between; }
.lecture-review-card { width: 48.3%; }
.lecture-review-card image { width: 100%; height: 230rpx; border-radius: 5rpx; background: #D7D2C8; }
.lecture-review-speaker { display: block; margin-top: 15rpx; color: #A34133; font-size: 14rpx; }
.lecture-review-title { display: -webkit-box; overflow: hidden; min-height: 88rpx; margin-top: 9rpx; font-family: "Songti SC", serif; font-size: 23rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.lecture-review-link { display: block; margin-top: 12rpx; color: #77746D; font-size: 16rpx; }
.activity-scroll { width: calc(100% + 32rpx); }
.activity-row { display: flex; padding-right: 32rpx; }
.activity-card { flex: none; width: 510rpx; margin-right: 18rpx; overflow: hidden; border-radius: 6rpx; background: #E7E1D6; }
.activity-card image { width: 100%; height: 290rpx; background: #D5D0C6; }
.activity-copy { padding: 23rpx; }
.activity-date { color: #9A4032; font-size: 14rpx; letter-spacing: 1rpx; }
.activity-title { display: block; min-height: 80rpx; margin-top: 11rpx; font-family: "Songti SC", serif; font-size: 27rpx; line-height: 1.5; }
.program-modal { width: 100%; max-height: 90vh; overflow: hidden; border-radius: 24rpx 24rpx 0 0; background: #F2EFE8; }
.program-modal-image { width: 100%; height: 390rpx; background: #D7D2C8; }
.program-modal-body { max-height: 650rpx; overflow-y: auto; padding: 28rpx 34rpx calc(env(safe-area-inset-bottom) + 34rpx); }
.program-modal-meta { display: block; margin-top: 10rpx; color: #85827A; font-size: 18rpx; line-height: 1.65; }
.program-modal-summary { display: block; margin-top: 23rpx; padding-top: 21rpx; border-top: 1rpx solid rgba(29,32,29,.12); color: #5D5E58; font-family: "Songti SC", serif; font-size: 22rpx; line-height: 1.85; text-align: justify; }
.modal-program-button { display: flex; align-items: center; justify-content: center; height: 76rpx; margin: 26rpx 0 0; padding: 0; border-radius: 3rpx; background: #A44234; color: white; font-size: 20rpx; line-height: 1; text-align: center; }
.modal-program-button.disabled { background: #D9D3C8; color: #8D8A82; }

/* 讲座/活动收藏按钮 */
.program-card-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; }
.program-card-bottom .program-button { margin: 0; }
.program-favorite-btn { display: flex; align-items: center; justify-content: center; width: 55rpx; height: 55rpx; border: 1rpx solid rgba(29,32,29,.18); border-radius: 50%; color: #555750; font-size: 28rpx; }
.program-favorite-btn.liked { border-color: #A64234; background: #A64234; color: white; }
.activity-card-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; }
.activity-card-bottom .program-button { margin: 0; }
.lecture-review-card { position: relative; }
.lecture-review-favorite { position: absolute; top: 14rpx; right: 14rpx; display: flex; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; border-radius: 50%; background: rgba(244,239,229,.9); color: #555750; font-size: 27rpx; z-index: 2; }
.lecture-review-favorite.liked { background: #A64234; color: white; }

/* 搜索栏入口 */
.search-bar { display: flex; align-items: center; margin-top: 32rpx; padding: 22rpx 26rpx; border: 1rpx solid rgba(29,32,29,.14); border-radius: 40rpx; background: rgba(255,255,255,.55); }
.search-icon { margin-right: 14rpx; color: #9D9A92; font-size: 30rpx; line-height: 1; }
.search-placeholder { color: #B5B1A8; font-size: 22rpx; letter-spacing: 1rpx; }

/* 搜索面板 */
.search-panel { position: fixed; inset: 0; z-index: 200; display: flex; flex-direction: column; background: #F2EFE8; }
.search-panel-header { display: flex; align-items: center; padding: calc(env(safe-area-inset-top) + 22rpx) 30rpx 20rpx; }
.search-input-wrap { display: flex; flex: 1; align-items: center; height: 72rpx; padding: 0 24rpx; border-radius: 40rpx; background: rgba(255,255,255,.75); }
.search-icon-inner { margin-right: 14rpx; color: #9D9A92; font-size: 30rpx; }
.search-input { flex: 1; height: 72rpx; font-size: 24rpx; color: #1D201D; }
.search-input-placeholder { color: #B5B1A8; }
.search-cancel { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; min-width: 62rpx; border: 1rpx solid rgba(29,32,29,.18); border-radius: 50%; color: #555750; font-size: 32rpx; line-height: 1; margin-right: 22rpx; flex-shrink: 0; }

/* 搜索 Tab */
.search-tabs { display: flex; padding: 12rpx 30rpx 0; border-bottom: 1rpx solid rgba(29,32,29,.1); }
.search-tab { display: flex; align-items: center; justify-content: center; flex: 1; height: 76rpx; margin-right: 12rpx; border-bottom: 3rpx solid transparent; color: #9D9A92; font-size: 24rpx; letter-spacing: 2rpx; }
.search-tab:last-child { margin-right: 0; }
.search-tab.active { border-bottom-color: #9A3D2F; color: #1D201D; font-weight: 600; }
.search-tab-count { margin-left: 8rpx; padding: 2rpx 10rpx; border-radius: 20rpx; background: #E7E1D6; color: #9A3D2F; font-size: 16rpx; font-weight: 400; }

/* 搜索结果区 */
.search-results { flex: 1; padding: 24rpx 30rpx; }
.search-empty { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; color: #9D9A92; }
.search-empty text:first-child { font-family: "Songti SC", serif; font-size: 28rpx; color: #7A7870; }
.search-empty text:last-child { margin-top: 12rpx; font-size: 20rpx; }

/* 搜索结果卡片 */
.search-result-card { display: flex; margin-bottom: 20rpx; overflow: hidden; border: 1rpx solid rgba(29,32,29,.1); border-radius: 7rpx; background: #E9E4DA; }
.search-result-image { flex: none; width: 220rpx; min-height: 220rpx; background: #D5D0C6; }
.search-result-copy { min-width: 0; flex: 1; padding: 22rpx; }
.search-result-tag { display: inline-flex; padding: 6rpx 12rpx; border-radius: 20rpx; font-size: 14rpx; letter-spacing: 1rpx; }
.search-result-tag.current { background: #9A3D2F; color: #FFF9F0; }
.search-result-tag.archive { background: #DED8CD; color: #7C544B; }
.search-result-tag.lecture { background: #DDE5DA; color: #4E6E54; }
.search-result-tag.activity { background: #E5DDD0; color: #8C6E3F; }
.search-result-title { display: block; margin-top: 14rpx; font-family: "Songti SC", serif; font-size: 27rpx; line-height: 1.45; }
.search-result-meta { display: block; margin-top: 8rpx; color: #85827A; font-size: 17rpx; line-height: 1.55; }

/* 搜索提示 */
.search-hint { display: flex; flex-direction: column; align-items: center; padding-top: 160rpx; color: #C5C1B8; }
.search-hint-icon { margin-bottom: 20rpx; font-size: 64rpx; }
.search-hint text:last-child { font-size: 20rpx; letter-spacing: 1rpx; }

/* 每日一画横滑区 */
.daily-painting-section { margin-top: 48rpx; }
.daily-painting-heading { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 24rpx; }
.daily-painting-title { display: block; margin-top: 10rpx; font-family: "Songti SC", serif; font-size: 43rpx; }
.daily-painting-date { padding-bottom: 6rpx; color: #96938B; font-size: 14rpx; letter-spacing: 2rpx; }
.daily-painting-scroll { width: calc(100% + 32rpx); }
.daily-painting-row { display: flex; padding-right: 32rpx; }
.daily-painting-card { position: relative; flex: none; width: 400rpx; height: 520rpx; margin-right: 18rpx; overflow: hidden; border-radius: 7rpx; background: #D5D0C6; }
.daily-painting-image { width: 100%; height: 100%; }
.daily-painting-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(20,20,18,.65)); }
.daily-painting-info { position: absolute; right: 24rpx; bottom: 24rpx; left: 24rpx; color: white; }
.daily-painting-name { display: block; font-family: "Songti SC", serif; font-size: 30rpx; line-height: 1.4; }
.daily-painting-artist { display: block; margin-top: 8rpx; color: rgba(255,255,255,.78); font-size: 18rpx; letter-spacing: 1rpx; }

/* 线上征集板块 */
.submission-section { margin-top: 92rpx; }
.submission-heading { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 27rpx; }
.submission-title { display: block; margin-top: 12rpx; font-family: "Songti SC", serif; font-size: 43rpx; }
.submission-count { padding-bottom: 6rpx; color: #96938B; font-size: 14rpx; letter-spacing: 2rpx; }
.submission-card { position: relative; height: 400rpx; overflow: hidden; border-radius: 7rpx; background: #2A2C27; box-shadow: 0 18rpx 50rpx rgba(43,42,37,.09); }
.submission-card:active { transform: scale(.995); }
.submission-card-bg { position: absolute; inset: 0; }
.submission-card-img { width: 100%; height: 100%; }
.submission-card-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,21,19,.1), rgba(20,21,19,.14) 45%, rgba(20,21,19,.82)); }
.submission-card-content { position: absolute; right: 28rpx; bottom: 29rpx; left: 28rpx; color: white; }
.submission-card-eyebrow { display: block; color: rgba(255,255,255,.65); font-size: 15rpx; letter-spacing: 3rpx; }
.submission-card-title { display: block; margin-top: 14rpx; font-family: "Songti SC", serif; font-size: 36rpx; line-height: 1.45; }
.submission-card-desc { display: block; margin-top: 12rpx; color: rgba(255,255,255,.75); font-family: "Songti SC", serif; font-size: 19rpx; line-height: 1.7; }
.submission-card-action { display: flex; justify-content: space-between; margin-top: 21rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(255,255,255,.28); color: rgba(255,255,255,.75); font-size: 17rpx; }
.submission-card-arrow { color: white; }

/* ============ 公告栏 ============ */
.announcement-bar { margin-top: 26rpx; overflow: hidden; border: 1rpx solid rgba(29,32,29,.1); border-radius: 10rpx; background: #E7E1D6; }
.announcement-track { display: flex; align-items: center; padding: 18rpx 22rpx; }
.announcement-tag { flex: none; margin-right: 14rpx; padding: 7rpx 14rpx; border-radius: 30rpx; background: #C9BFAF; color: #5E5A51; font-size: 16rpx; letter-spacing: 1rpx; }
.announcement-tag.urgent { background: #9A3D2F; color: #FFF9F0; }
.announcement-swiper { flex: 1; height: 44rpx; }
.announcement-text { display: flex; align-items: center; height: 44rpx; overflow: hidden; color: #4A4B44; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.announcement-more { flex: none; margin-left: 12rpx; color: #9A3D2F; font-size: 17rpx; letter-spacing: 1rpx; }
.announcement-dots { display: flex; align-items: center; justify-content: center; gap: 9rpx; padding: 0 0 13rpx; }
.announcement-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: #C4C0B7; transition: width .2s ease; }
.announcement-dot.active { width: 26rpx; border-radius: 10rpx; background: #9A3D2F; }

/* ============ 快捷入口 ============ */
.quick-nav { display: flex; margin-top: 26rpx; padding: 20rpx 12rpx; border: 1rpx solid rgba(29,32,29,.08); border-radius: 12rpx; background: rgba(255,255,255,.45); }
.quick-item { display: flex; flex: 1; flex-direction: column; align-items: center; }
.quick-icon { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border: 1rpx solid rgba(29,32,29,.13); border-radius: 18rpx; background: #EFE9DE; color: #5E5447; font-family: "Songti SC", serif; font-size: 26rpx; }
.quick-item:active .quick-icon { background: #E2D9CA; }
.quick-label { margin-top: 11rpx; color: #6C6A63; font-size: 18rpx; letter-spacing: 1rpx; }

/* ============ 公告弹窗 ============ */
.announcement-modal { width: 88%; max-height: 78vh; display: flex; flex-direction: column; margin: auto; padding: 32rpx 34rpx 34rpx; overflow: hidden; border-radius: 16rpx; background: #F2EFE8; }
.announcement-modal-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.announcement-modal-tag { padding: 8rpx 16rpx; border-radius: 30rpx; background: #DED8CD; color: #6B4A3A; font-size: 17rpx; letter-spacing: 1rpx; }
.announcement-modal-tag.urgent { background: #9A3D2F; color: #FFF9F0; }
.announcement-modal-title { display: block; margin-top: 22rpx; font-family: "Songti SC", serif; font-size: 34rpx; line-height: 1.5; }
.announcement-modal-scroll { flex: 1; max-height: 46vh; margin-top: 20rpx; }
.announcement-modal-content { display: block; color: #5D5E58; font-family: "Songti SC", serif; font-size: 21rpx; line-height: 1.85; text-align: justify; white-space: pre-wrap; }
.announcement-modal .modal-program-button { flex: none; margin-top: 26rpx; }
