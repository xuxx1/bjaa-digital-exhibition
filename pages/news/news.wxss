.news-scroll { height: 100vh; background: #F2EFE8; }.news-page { min-height: 100vh; padding-bottom: 80rpx; }
.news-head { padding: 60rpx 36rpx 38rpx; }.news-title { display: block; margin-top: 14rpx; font-family: "Songti SC", serif; font-size: 55rpx; }.news-lead { display: block; width: 560rpx; margin-top: 19rpx; color: #7E7C74; font-family: "Songti SC", serif; font-size: 21rpx; line-height: 1.8; }
.featured-news { position: relative; height: 590rpx; margin: 0 36rpx; overflow: hidden; border-radius: 7rpx; color: white; }.featured-news > image { width: 100%; height: 100%; }.featured-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,21,18,.04), rgba(20,21,18,.12) 40%, rgba(20,21,18,.9)); }.featured-tag { position: absolute; top: 24rpx; left: 24rpx; padding: 10rpx 16rpx; border-radius: 40rpx; background: #A64234; font-size: 16rpx; letter-spacing: 2rpx; }.featured-copy { position: absolute; right: 27rpx; bottom: 26rpx; left: 27rpx; }.featured-date { color: rgba(255,255,255,.58); font-size: 16rpx; letter-spacing: 2rpx; }.featured-title { display: block; margin-top: 12rpx; font-family: "Songti SC", serif; font-size: 34rpx; line-height: 1.45; }.featured-link { display: flex; justify-content: space-between; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(255,255,255,.22); font-size: 18rpx; }
.news-section-head { display: flex; justify-content: space-between; margin: 70rpx 36rpx 22rpx; padding-bottom: 18rpx; border-bottom: 1rpx solid rgba(29,32,29,.14); font-family: "Songti SC", serif; font-size: 29rpx; }.news-section-head text:last-child { color: #99968E; font-family: sans-serif; font-size: 14rpx; letter-spacing: 2rpx; }
.news-list { padding: 0 36rpx; }.news-item { display: flex; padding: 24rpx 0; border-bottom: 1rpx solid rgba(29,32,29,.11); }.news-thumb, .notice-thumb { flex: none; width: 210rpx; height: 240rpx; margin-right: 22rpx; border-radius: 4rpx; background: #D9D4CA; }.notice-thumb { display: flex; flex-direction: column; align-items: center; justify-content: center; background: #E4DED3; }.notice-thumb image { width: 53rpx; height: 53rpx; border: 5rpx solid white; background: white; }.notice-thumb text { margin-top: 15rpx; color: #9A3F32; font-size: 13rpx; letter-spacing: 3rpx; }.news-item-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }.news-meta { display: flex; justify-content: space-between; color: #9C4134; font-size: 14rpx; }.news-meta text:last-child { color: #96938B; }.news-item-title { display: -webkit-box; overflow: hidden; margin-top: 13rpx; font-family: "Songti SC", serif; font-size: 24rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.news-summary { display: -webkit-box; overflow: hidden; margin-top: 9rpx; color: #85827A; font-size: 16rpx; line-height: 1.6; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.news-arrow { margin-top: auto; color: #3A3C37; font-size: 15rpx; }
.news-footer { display: flex; flex-direction: column; margin: 70rpx 36rpx 0; padding: 25rpx 0; border-top: 1rpx solid rgba(29,32,29,.13); color: #99968E; font-size: 14rpx; line-height: 1.9; letter-spacing: 1rpx; }
