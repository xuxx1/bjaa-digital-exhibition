.detail-scroll { height: 100vh; background: #F2EFE8; }.detail-page { min-height: 100vh; }
.news-cover { position: relative; height: 570rpx; background: #D8D3C9; }.news-cover > image { width: 100%; height: 100%; }.cover-tip { position: absolute; right: 25rpx; bottom: 22rpx; padding: 10rpx 15rpx; border-radius: 4rpx; background: rgba(24,25,22,.7); color: white; font-size: 16rpx; }
.notice-cover { display: flex; height: 400rpx; flex-direction: column; align-items: center; justify-content: center; background: #E3DDD2; }.notice-cover image { width: 80rpx; height: 80rpx; border: 8rpx solid white; background: white; }.notice-cover text:nth-child(2) { margin-top: 24rpx; font-family: Georgia, serif; font-size: 20rpx; letter-spacing: 3rpx; }.notice-cover text:last-child { margin-top: 8rpx; color: #A54234; font-size: 14rpx; letter-spacing: 4rpx; }
.article { padding: 50rpx 36rpx 85rpx; }.article-meta { display: flex; justify-content: space-between; color: #A54234; font-size: 16rpx; letter-spacing: 2rpx; }.article-meta text:last-child { color: #918E86; }.article-title { display: block; margin-top: 18rpx; font-family: "Songti SC", serif; font-size: 43rpx; line-height: 1.5; }.article-summary { display: block; margin-top: 24rpx; padding: 21rpx 23rpx; border-left: 5rpx solid #A54234; background: #E7E1D6; color: #686861; font-family: "Songti SC", serif; font-size: 21rpx; line-height: 1.8; }.article-divider { display: flex; align-items: center; margin: 45rpx 0 33rpx; color: #A09D95; font-size: 15rpx; letter-spacing: 3rpx; }.article-divider view { flex: 1; height: 1rpx; background: rgba(29,32,29,.13); }.article-divider text { padding: 0 19rpx; }.paragraphs text { display: block; margin-bottom: 25rpx; color: #555750; font-family: "Songti SC", serif; font-size: 23rpx; line-height: 2; text-align: justify; }.source-note { display: flex; flex-direction: column; margin-top: 45rpx; padding: 21rpx 0; border-top: 1rpx solid rgba(29,32,29,.13); border-bottom: 1rpx solid rgba(29,32,29,.13); color: #97948C; font-size: 15rpx; line-height: 1.8; }.source-note text:first-child { color: #A54234; }.article-footer { display: flex; align-items: center; margin-top: 45rpx; }.article-footer image { width: 58rpx; height: 58rpx; margin-right: 15rpx; border: 6rpx solid white; background: white; }.article-footer > view { display: flex; flex-direction: column; }.article-footer text:first-child { font-family: "Songti SC", serif; font-size: 22rpx; }.article-footer text:last-child { margin-top: 5rpx; color: #A09D95; font-size: 12rpx; letter-spacing: 2rpx; }
