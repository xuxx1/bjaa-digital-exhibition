.sub-scroll { height: 100vh; background: #F2EFE8; }
.sub-page { min-height: 100vh; padding-bottom: 80rpx; }
.sub-head { padding: 60rpx 36rpx 30rpx; }
.sub-title { display: block; margin-top: 14rpx; font-family: "Songti SC", serif; font-size: 55rpx; }
.sub-lead { display: block; width: 560rpx; margin-top: 19rpx; color: #7E7C74; font-family: "Songti SC", serif; font-size: 21rpx; line-height: 1.8; }

/* 投稿入口 */
.sub-cta { display: flex; align-items: center; justify-content: space-between; margin: 0 36rpx 40rpx; padding: 34rpx 32rpx; border-radius: 8rpx; background: linear-gradient(135deg, #3A342A, #6B4A3A); color: #F8F3E9; }
.sub-cta-copy { flex: 1; min-width: 0; }
.sub-cta-eyebrow { font-size: 13rpx; letter-spacing: 3rpx; color: rgba(255,255,255,.55); }
.sub-cta-title { display: block; margin-top: 12rpx; font-family: "Songti SC", serif; font-size: 40rpx; font-weight: 600; }
.sub-cta-desc { display: block; margin-top: 10rpx; font-size: 18rpx; line-height: 1.6; color: rgba(255,255,255,.7); }
.sub-cta-arrow { display: flex; align-items: center; justify-content: center; flex: none; width: 56rpx; height: 56rpx; border: 1rpx solid rgba(255,255,255,.4); border-radius: 50%; font-size: 26rpx; }
.sub-cta:active { opacity: .9; }

/* 作品列表 */
.sub-section-head { display: flex; justify-content: space-between; margin: 20rpx 36rpx 22rpx; padding-bottom: 18rpx; border-bottom: 1rpx solid rgba(29,32,29,.14); font-family: "Songti SC", serif; font-size: 29rpx; }
.sub-section-head text:last-child { color: #99968E; font-family: sans-serif; font-size: 14rpx; letter-spacing: 2rpx; }
.sub-grid { display: flex; flex-wrap: wrap; justify-content: space-between; padding: 0 36rpx; }
.sub-card { width: 318rpx; margin-bottom: 46rpx; }
.sub-visual { position: relative; height: 400rpx; overflow: hidden; border-radius: 5rpx; background: #DDD8CE; }
.sub-image { width: 100%; height: 100%; }
.sub-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; background: linear-gradient(135deg, #E8E2D6, #CFC6B4); }
.sub-placeholder text { color: #8A7C63; font-family: "Songti SC", serif; font-size: 64rpx; }
.sub-info { padding-top: 18rpx; }
.sub-work-title { display: -webkit-box; overflow: hidden; font-family: "Songti SC", serif; font-size: 25rpx; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.sub-author { display: block; margin-top: 8rpx; color: #9C4134; font-size: 16rpx; letter-spacing: 1rpx; }
.sub-intro { display: -webkit-box; overflow: hidden; margin-top: 8rpx; color: #85827A; font-size: 16rpx; line-height: 1.6; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }

/* 空态 */
.sub-empty { display: flex; flex-direction: column; align-items: center; padding: 100rpx 0 60rpx; }
.sub-empty-glyph { font-size: 60rpx; color: #C5C1B8; }
.sub-empty-title { margin-top: 20rpx; color: #7A7870; font-family: "Songti SC", serif; font-size: 29rpx; }
.sub-empty-hint { margin-top: 12rpx; color: #A09D95; font-size: 20rpx; }

.sub-footer { display: flex; flex-direction: column; margin: 70rpx 36rpx 0; padding: 25rpx 0; border-top: 1rpx solid rgba(29,32,29,.13); color: #99968E; font-size: 14rpx; line-height: 1.9; letter-spacing: 1rpx; }