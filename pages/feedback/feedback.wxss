.fb-scroll { height: 100vh; background: #F2EFE8; }
.fb-page { min-height: 100vh; padding-bottom: 80rpx; }
.fb-head { padding: 60rpx 36rpx 30rpx; }
.fb-title { display: block; margin-top: 14rpx; font-family: "Songti SC", serif; font-size: 55rpx; }
.fb-lead { display: block; width: 580rpx; margin-top: 19rpx; color: #7E7C74; font-family: "Songti SC", serif; font-size: 21rpx; line-height: 1.8; text-align: justify; }

.fb-form { padding: 0 36rpx; }
.fb-field { margin-bottom: 38rpx; }
.fb-label { display: block; margin-bottom: 15rpx; color: #4A4B44; font-family: "Songti SC", serif; font-size: 23rpx; }
.fb-required { color: #A34133; }
.fb-optional { color: #9A978E; font-size: 18rpx; }

/* 分类选择 */
.fb-cats { display: flex; flex-wrap: wrap; gap: 16rpx; }
.fb-category { padding: 15rpx 30rpx; border: 1rpx solid rgba(29,32,29,.18); border-radius: 40rpx; background: rgba(255,255,255,.5); color: #6C6A63; font-size: 22rpx; }
.fb-category.active { border-color: #9A3D2F; background: #9A3D2F; color: white; }

/* 输入区 */
.fb-textarea { width: 100%; min-height: 230rpx; box-sizing: border-box; padding: 22rpx 24rpx; border: 1rpx solid rgba(29,32,29,.16); border-radius: 6rpx; background: rgba(255,255,255,.6); font-size: 24rpx; color: #1D201D; line-height: 1.7; }
.fb-input { width: 100%; box-sizing: border-box; padding: 20rpx 24rpx; border: 1rpx solid rgba(29,32,29,.16); border-radius: 6rpx; background: rgba(255,255,255,.6); font-size: 24rpx; color: #1D201D; }
.fb-contact { width: 100%; min-height: 88rpx; box-sizing: border-box; padding: 22rpx 24rpx; border: 1rpx solid rgba(29,32,29,.16); border-radius: 6rpx; background: rgba(255,255,255,.6); font-size: 24rpx; color: #1D201D; line-height: 1.7; }
.fb-placeholder { color: #B5B1A8; font-size: 24rpx; font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif; }
.fb-counter { display: block; margin-top: 10rpx; color: #B0ACA2; font-size: 17rpx; text-align: right; }
.fb-tip { display: block; margin-top: 10rpx; color: #B0ACA2; font-size: 17rpx; }

/* 提交按钮 */
.fb-submit-row { padding: 10rpx 36rpx 0; }
.fb-submit { display: flex; align-items: center; justify-content: center; width: 100%; height: 88rpx; box-sizing: border-box; border-radius: 6rpx; background: #9A3D2F; color: white; font-family: "Songti SC", serif; font-size: 28rpx; letter-spacing: 4rpx; line-height: 1; text-align: center; }
.fb-submit::after { border: none; }
.fb-submit:active { opacity: .88; }
.fb-submit.disabled { opacity: .5; }

/* 反馈说明 */
.fb-note { display: flex; flex-direction: column; margin: 44rpx 36rpx 0; padding: 24rpx 26rpx; border-left: 4rpx solid #C9A98C; background: rgba(255,255,255,.45); }
.fb-note text:first-child { color: #6B4A3A; font-family: "Songti SC", serif; font-size: 21rpx; letter-spacing: 1rpx; }
.fb-note text:last-child { margin-top: 10rpx; color: #8B867C; font-size: 17rpx; line-height: 1.7; text-align: justify; }

.fb-footer { display: flex; flex-direction: column; margin: 70rpx 36rpx 0; padding: 25rpx 0; border-top: 1rpx solid rgba(29,32,29,.13); color: #99968E; font-size: 14rpx; line-height: 1.9; letter-spacing: 1rpx; }

/* 我的反馈 */
.fb-mine { margin: 50rpx 36rpx 0; }
.fb-mine-head { display: flex; align-items: baseline; gap: 16rpx; margin-bottom: 24rpx; }
.fb-mine-title { font-family: "Songti SC", serif; font-size: 26rpx; color: #4A4B44; }
.fb-mine-count { font-size: 18rpx; color: #B0ACA2; }
.fb-mine-list { display: flex; flex-direction: column; gap: 20rpx; }
.fb-mine-item { padding: 24rpx 26rpx; background: rgba(255,255,255,.55); border-radius: 6rpx; border: 1rpx solid rgba(29,32,29,.10); }
.fb-mine-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.fb-mine-cat { font-size: 20rpx; color: #9A3D2F; border: 1rpx solid #9A3D2F; border-radius: 30rpx; padding: 4rpx 16rpx; }
.fb-mine-status { font-size: 18rpx; color: #B0ACA2; }
.fb-mine-status-pending { color: #C99A3C; }
.fb-mine-status-done { color: #5B8C5A; }
.fb-mine-status-ignored { color: #B0ACA2; }
.fb-mine-content { display: block; font-size: 23rpx; color: #1D201D; line-height: 1.7; text-align: justify; word-break: break-all; }
.fb-mine-date { display: block; margin-top: 10rpx; font-size: 16rpx; color: #C2BEB4; }

/* 管理员回复 */
.fb-reply { margin-top: 16rpx; padding: 16rpx 18rpx; background: rgba(154,61,47,.06); border-left: 3rpx solid #9A3D2F; border-radius: 0 4rpx 4rpx 0; }
.fb-reply-label { display: block; font-size: 18rpx; color: #9A3D2F; margin-bottom: 6rpx; }
.fb-reply-content { display: block; font-size: 22rpx; color: #4A4B44; line-height: 1.7; text-align: justify; word-break: break-all; }
.fb-reply-date { display: block; margin-top: 6rpx; font-size: 15rpx; color: #C2BEB4; }

/* 查看我的反馈按钮 */
.fb-check-mine { margin: 30rpx 36rpx 0; }
.fb-check-btn { display: flex; align-items: center; justify-content: center; width: 100%; height: 76rpx; box-sizing: border-box; border: 1rpx solid rgba(29,32,29,.20); border-radius: 6rpx; background: transparent; color: #6C6A63; font-size: 24rpx; line-height: 1; }
.fb-check-btn::after { border: none; }
.fb-check-btn:active { opacity: .8; }