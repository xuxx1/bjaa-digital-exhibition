.courses-scroll { height: 100vh; background: #F2EFE8; }
.courses-page { min-height: 100vh; padding-bottom: 80rpx; }
.courses-head { padding: 60rpx 36rpx 38rpx; }
.courses-title { display: block; margin-top: 14rpx; font-family: "Songti SC", serif; font-size: 55rpx; }
.courses-lead { display: block; width: 560rpx; margin-top: 19rpx; color: #7E7C74; font-family: "Songti SC", serif; font-size: 21rpx; line-height: 1.8; }

/* 分类筛选 */
.category-row { display: flex; flex-wrap: wrap; gap: 14rpx; padding: 0 36rpx; margin-bottom: 30rpx; }
.category { padding: 14rpx 28rpx; border: 1rpx solid rgba(29,32,29,.16); border-radius: 40rpx; color: #555750; font-size: 20rpx; letter-spacing: 1rpx; background: rgba(255,255,255,.35); }
.category.active { border-color: #1D201D; background: #1D201D; color: white; }

/* 课程列表 */
.course-list { padding: 0 36rpx; }
.course-card { display: flex; margin-bottom: 34rpx; border: 1rpx solid rgba(29,32,29,.11); border-radius: 7rpx; background: rgba(255,255,255,.5); overflow: hidden; }
.course-visual { position: relative; flex: none; width: 250rpx; height: 250rpx; background: #DDD8CE; }
.course-cover { width: 100%; height: 100%; }
.course-cover-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; background: linear-gradient(135deg, #E8E2D6, #CFC6B4); }
.course-cover-glyph { color: #8A7C63; font-size: 60rpx; }
.course-type-tag { position: absolute; top: 14rpx; left: 14rpx; padding: 7rpx 12rpx; border-radius: 30rpx; background: rgba(248,245,238,.9); color: #9A3D2F; font-size: 15rpx; letter-spacing: 1rpx; }
.course-duration { position: absolute; right: 14rpx; bottom: 14rpx; padding: 6rpx 12rpx; border-radius: 30rpx; background: rgba(20,20,18,.62); color: white; font-size: 16rpx; }
.course-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; padding: 22rpx 24rpx; }
.course-title { display: -webkit-box; overflow: hidden; font-family: "Songti SC", serif; font-size: 25rpx; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.course-category { margin-top: 10rpx; color: #9C4134; font-size: 16rpx; letter-spacing: 1rpx; }
.course-summary { display: -webkit-box; overflow: hidden; margin-top: 10rpx; color: #85827A; font-size: 17rpx; line-height: 1.6; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }

/* 空态 */
.course-empty { display: flex; flex-direction: column; align-items: center; padding: 110rpx 0 60rpx; }
.course-empty-glyph { font-size: 60rpx; color: #C5C1B8; }
.course-empty-title { margin-top: 20rpx; color: #7A7870; font-family: "Songti SC", serif; font-size: 29rpx; }
.course-empty-hint { margin-top: 12rpx; color: #A09D95; font-size: 20rpx; }

.courses-footer { display: flex; flex-direction: column; margin: 70rpx 36rpx 0; padding: 25rpx 0; border-top: 1rpx solid rgba(29,32,29,.13); color: #99968E; font-size: 14rpx; line-height: 1.9; letter-spacing: 1rpx; }